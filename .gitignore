# --- Dependencies ---
# Never commit node_modules. They are re-installed via 'npm install'
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Environment Variables (CRITICAL SECURITY) ---
# This protects your DATABASE_URL and JWT_SECRET
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Logs ---
# Keeps local server logs out of the repo
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Runtime / Build ---
# If you use TypeScript or a build step
dist/
build/
out/
.npm
.eslintcache

# --- Database Specific ---
# If you use local SQLite or migrations that shouldn't be shared
*.db
*.sqlite

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- IDE / Editor Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo